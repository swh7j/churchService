{
  "name": "church-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "교회 회계·교인·주보·예배 자료 관리 웹 서비스 (실제 교회 운영 중)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node scripts/run-api.mjs\" \"vite\"",
    "build": "vite build --outDir api/src/main/resources/static --emptyOutDir && node scripts/run-api.mjs package",
    "start": "cd api && java -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -jar target/church-api.jar",
    "reset": "node server/reset.js",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy/deploy.ps1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jszip": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
